{
  "expo": {
    "name": "Purl",
    "slug": "purl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "scheme": "purl",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "me.ritom.purl",
      "buildNumber": "1",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Purl needs camera access to take photos and videos for messages, video calls, and status updates.",
        "NSMicrophoneUsageDescription": "Purl needs microphone access to record voice messages, make voice and video calls.",
        "NSPhotoLibraryUsageDescription": "Purl needs photo library access to share images and videos in messages and status updates.",
        "NSPhotoLibraryAddUsageDescription": "Purl saves received media to your photo library.",
        "NSContactsUsageDescription": "Purl accesses your contacts to help you find people you know.",
        "UIBackgroundModes": [
          "voip",
          "audio",
          "fetch",
          "remote-notification",
          "voip",
          "audio",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "me.ritom.purl",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosClientId": "955786749612-2difsmgsqa7hfp32cgmql6qk3qr6g8cb.apps.googleusercontent.com",
          "iosUrlScheme": "com.googleusercontent.apps.955786749612-2difsmgsqa7hfp32cgmql6qk3qr6g8cb"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Purl needs camera access to take photos, videos, and for QR code scanning.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Purl needs photo library access to share images and videos.",
          "cameraPermission": "Purl needs camera access to take photos and videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Purl needs photo library access to save received media.",
          "savePhotosPermission": "Purl needs permission to save photos to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],

      [
        "expo-contacts",
        {
          "contactsPermission": "Purl accesses your contacts to help you find people you know."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      "react-native-bottom-tabs",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2f5eb737-6872-4b84-81a3-663a1448ff30"
      }
    },
    "owner": "ritomg"
  }
}
